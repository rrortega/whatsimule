{
  "name": "rrortega-whatsimule",
  "version": "1.0.37",
  "description": "Interactive, animated 3D WhatsApp conversation simulator component for React and Web framework applications with Web Audio API sound synthesis.",
  "homepage": "https://rrortega.github.io/whatsimule/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rrortega/whatsimule.git"
  },
  "bugs": {
    "url": "https://github.com/rrortega/whatsimule/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./dist/whatsapp-simulator.css": "./dist/whatsapp-simulator.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "README.es.md",
    "LICENSE",
    "preview.png",
    "demo.gif"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "serve": "pnpm dlx serve .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "keywords": [
    "react",
    "whatsapp",
    "simulator",
    "chat-simulator",
    "web-components",
    "framer-motion",
    "interactive-demo",
    "ai-assistant-demo"
  ],
  "author": "https://github.com/rrortega",
  "license": "MIT",
  "peerDependencies": {
    "framer-motion": ">=10.0.0",
    "lucide-react": ">=0.200.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "framer-motion": "^12.0.0",
    "lucide-react": "^0.474.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3"
  }
}